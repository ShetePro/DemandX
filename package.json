{
  "name": "demandx",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "sh -c 'pnpm dev & pnpm worker & wait'",
    "worker": "tsx src/worker/main.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "crawl:login": "tsx scripts/crawl-login.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "eval:extract": "tsx scripts/eval-extract.ts",
    "cases:ingest": "tsx scripts/ingest-cases.ts",
    "cases:ideas": "tsx scripts/ingest-case-ideas.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "tokens:check": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@ai-sdk/react": "4.0.16",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@hookform/resolvers": "6.0.2",
    "@mozilla/readability": "^0.6.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.0.3",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.24",
    "ai": "7.0.156",
    "cheerio": "^1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "jsdom": "^26.1.0",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nuqs": "2.10.2",
    "p-limit": "^6.1.0",
    "pg-boss": "12.38.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "rehype-harden": "^1.1.8",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "sonner": "2.0.8",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "undici": "^7.0.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "5.0.5"
  }
}
