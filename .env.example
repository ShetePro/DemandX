DATABASE_URL=postgres://demandx:demandx@127.0.0.1:5433/demandx
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEMANDX_SECRET_FILE=~/.demandx/secret.key
CRAWL_ENABLED=true
CRAWL_RESPECT_ROBOTS=true
SNAPSHOT_DIR=./data/snapshots

# Fallback web search used when no platform session/adapters answer a query.
# Leave both empty to use the settings page (/settings/crawl) instead.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
# Optional proxy/test endpoint override for the selected provider.
WEB_SEARCH_BASE_URL=
